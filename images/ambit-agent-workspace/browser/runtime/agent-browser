#!/usr/bin/env bash
# The workspace is already scoped to its tenant, principal, Run, grant and
# generation. Keep browser state inside that boundary and use the Runner's
# network configuration; this launcher is not an authorization boundary.
set -euo pipefail
umask 077

export AGENT_BROWSER_EXECUTABLE_PATH=/opt/ambit/browser/chrome/chrome
export AGENT_BROWSER_REQUIRE_SANDBOX=1
# The bound on a browser left open. Only a canceled Run deletes its workspace
# sessions; a completed Run leaves this scope owned and running, so without a
# standalone timer nothing inside the session ends it. Ten minutes matches the
# workspace's own inactivity auto-stop, so an idle browser never outlives the
# workspace that owns it, and it also bounds an idle browser inside a workspace
# that stays busy with other work. After it elapses the next command starts a
# fresh daemon: page state is gone, which is honest recovery, not a resumed page.
export AGENT_BROWSER_IDLE_TIMEOUT_MS="${AGENT_BROWSER_IDLE_TIMEOUT_MS:-600000}"
export AGENT_BROWSER_SOCKET_DIR=/workspace/.ambit/browser/sockets
export AGENT_BROWSER_CONTENT_BOUNDARIES=1
export AGENT_BROWSER_DOWNLOAD_PATH="${AGENT_BROWSER_DOWNLOAD_PATH:-/workspace/outputs/downloads}"
export AGENT_BROWSER_SCREENSHOT_DIR="${AGENT_BROWSER_SCREENSHOT_DIR:-/workspace/work/browser/screenshots}"

mkdir -p "$AGENT_BROWSER_SOCKET_DIR" "$AGENT_BROWSER_DOWNLOAD_PATH" "$AGENT_BROWSER_SCREENSHOT_DIR"

# Chromium does not consume HTTP(S)_PROXY or SSL_CERT_FILE itself. The native
# driver maps these existing provider settings to Chrome proxy/NSS trust and
# retains certificate verification. The proxy value is forwarded verbatim: this
# launcher neither rewrites, stores nor prints it, and it adds no credential
# handling of its own. Only an unauthenticated CONNECT proxy is covered by
# conformance/proxy.py, so an authenticated proxy is unverified here.
if [[ -z "${AGENT_BROWSER_PROXY:-}" ]]; then
  browser_proxy="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"
  if [[ -n "$browser_proxy" ]]; then
    export AGENT_BROWSER_PROXY="$browser_proxy"
  fi
fi
if [[ -z "${AGENT_BROWSER_PROXY_BYPASS:-}" && -n "${NO_PROXY:-${no_proxy:-}}" ]]; then
  browser_proxy_bypass="${NO_PROXY:-${no_proxy:-}}"
  export AGENT_BROWSER_PROXY_BYPASS="${browser_proxy_bypass//,/;}"
fi
if [[ -z "${AGENT_BROWSER_CA_CERT:-}" && -n "${SSL_CERT_FILE:-}" ]]; then
  export AGENT_BROWSER_CA_CERT="$SSL_CERT_FILE"
fi

exec /opt/ambit/browser/bin/agent-browser "$@"
