{
  "schema": "ambit.runtime-pack-policy/v1",
  "runtimeUser": "daytona",
  "rootEscalation": "denied",
  "hostSocketMounts": "denied",
  "runtimePackageInstallers": "absent",
  "packageInstallScriptsByDefault": "unavailable",
  "pythonSourceBuildsByDefault": "unavailable",
  "pythonDependencyHashes": "required",
  "dependencyNetworkByDefault": "disabled",
  "workspaceWriteRoot": "/workspace",
  "packRoot": "/opt/ambit/runtime-pack/core-document",
  "packRootMutability": "read-only",
  "secretsInImage": "denied",
  "atomicMaterializer": "provider-implementation-not-runtime-capability",
  "derivedHtmlPreview": "diagnostic-non-layout-authoritative",
  "documentRenderCapability": "unavailable-until-C19-paginated-renderer"
}
