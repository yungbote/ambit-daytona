#!/usr/bin/env sh
set -eu

pack_bin=/opt/ambit/runtime-pack/core-document/node/node_modules/.bin

case "${1:-}" in
  --version|-v)
    printf '%s\n' '10.9.8'
    exit 0
    ;;
  --no-install)
    shift
    ;;
esac
if [ "$#" -eq 0 ]; then
  echo "usage: npx [--no-install] <admitted-pack-command> [args...]" >&2
  exit 64
fi

case "$1" in
  */*)
    echo "npx command must be an admitted pack command name" >&2
    exit 65
    ;;
esac

command_name=$1
shift
resolved=$(command -v "${command_name}" || true)
case "${resolved}" in
  "${pack_bin}"/*)
    exec "${resolved}" "$@"
    ;;
  *)
    echo "npx command is not present in the immutable admitted pack: ${command_name}" >&2
    exit 66
    ;;
esac
