{
  "filesystem": {
    "packRootsReadOnly": true,
    "rootFilesystemReadOnly": true,
    "writableRoots": [
      "/workspace",
      "/tmp/ambit-task"
    ]
  },
  "identity": {
    "gid": 1000,
    "group": "daytona",
    "supplementaryGroups": [],
    "uid": 1000,
    "user": "daytona"
  },
  "network": {
    "conformance": "none",
    "runtime": "none"
  },
  "process": {
    "linuxCapabilities": [],
    "noNewPrivileges": true,
    "requiredSyscalls": [
      "openat2"
    ],
    "seccomp": "provider-default-deny-escape"
  },
  "runtimeInstallers": {
    "disposition": "absent",
    "forbiddenCommands": [
      "apk",
      "apt",
      "apt-get",
      "conda",
      "corepack",
      "dpkg",
      "dpkg-deb",
      "mamba",
      "micromamba",
      "npm",
      "npx",
      "pip",
      "pip3",
      "pnpm",
      "uv",
      "yarn"
    ]
  },
  "schema": "ambit.c18-runtime-policy/v3",
  "semanticJobRoots": {
    "callerPathSelection": "forbidden",
    "conformance": {
      "profileRef": "ambit.workspace-runtime/c18-specialist-conformance@1",
      "root": "/ambit"
    },
    "product": {
      "filesystemAuthority": "none",
      "jobRefPattern": "ambit://artifact-render-jobs/<lowercase-uuid>",
      "logicalRootPattern": "/workspace/.ambit/render-jobs/<lowercase-uuid>",
      "matchingJobIdRequired": true,
      "transport": {
        "digest": "sha256:253ea86e0d8f6593a5fa4a25c10db1971052539227cfac83207df9b34c11eff3",
        "ref": "ambit.runtime-interface/specialist-render@1"
      }
    }
  },
  "secrets": {
    "secretShapedEnvironmentForbidden": true,
    "workspacePlaintextPersistenceForbidden": true
  },
  "sockets": {
    "forbidden": [
      "/run/containerd/containerd.sock",
      "/run/k3s/containerd/containerd.sock",
      "/run/podman/podman.sock",
      "/var/run/crio/crio.sock",
      "/var/run/docker.sock",
      "/var/run/podman/podman.sock"
    ]
  }
}
